// Read-only Cloudflare Workers demo. Deploy by hand with `npx wrangler deploy` only when you mean to.
{
  "name": "namtuam-mai-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // The map page. Files here are served first; other paths (the API) reach src/worker.ts.
  // /tiles/* goes to the worker first, which answers Range requests with 206 (see serveTiles).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/tiles/*"] }
}
